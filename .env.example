# Copy to .env and fill in. In production the whole file is stored in the
# PROD_SECRETS GitHub secret and written to the server by the deploy workflow.

# MySQL connection: mysql://USER:PASSWORD@HOST:3306/DATABASE
# On the VPS itself use localhost.
DATABASE_URL="mysql://appuser:PASSWORD@localhost:3306/appdb"

# Public origin, used for canonical URLs, sitemap and Facebook OG tags.
SITE_URL="https://example.mn"

# Where uploaded photos live. Must be OUTSIDE the git checkout in production.
UPLOAD_DIR="/home/cloudmn/apps/myanganbuu-data/uploads"

# Random 32+ byte string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Web Push keys for inquiry notifications: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# PM2 / next start
PORT=4000
